[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta data should be tracked.
!/[Aa]ssets/**/*.meta
!/[Pp]ackages/**/*.meta
!/[Pp]roject[Ss]ettings/**/*.meta

# Addressables and generated bundles.
[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Studio / Rider / VS Code
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

.vs/
.vscode/
.idea/

# Unity generated files
*.apk
*.aab
*.unitypackage
*.app

# Crash reporting
sysinfo.txt

# Editor screenshot dumps (MCP verification shots) — never commit
Assets/Screenshots/
Assets/Screenshots.meta
*.blob

# Scratch import folder for source FBX drops (extracted assets are committed,
# the multi-hundred-MB sources are not). The folder itself is caught by the
# global [Tt]emp/ rule; the stray .meta needs its own line.
Assets/Temp.meta

# Huge third-party animal pack — kept locally, never committed (wolf assets copied to Assets/HexLive/Art/Wolf)
/[Aa]ssets/ANIMALS FULL PACK/
/[Aa]ssets/ANIMALS FULL PACK.meta

# §67.12: FMOD-интеграция — 297 МБ сторонних бинарников, качается с fmod.com
# («FMOD for Unity», версия обязана совпадать с FMOD Studio: сейчас 2.03.14).
/Assets/Plugins/FMOD/
# §67.10: FMOD Studio при импорте КОПИРУЕТ аудио к себе — это байт-в-байт те же
# реплики, что уже лежат в StreamingAssets (LFS). Восстанавливается прогоном
# FMODStudio/Scripts/sync_voices.js, дублировать 205 МБ в LFS незачем.
/FMODStudio/HexLive/Assets/
# Лог редактора FMOD.
/fmod_editor.log
