[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta data should be tracked.
!/[Aa]ssets/**/*.meta
!/[Pp]ackages/**/*.meta
!/[Pp]roject[Ss]ettings/**/*.meta

# Addressables and generated bundles.
[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Studio / Rider / VS Code
*.csproj
*.unityproj
*.sln
# ...кроме рукописных: Unity-генерируемые csproj одноразовые и не в git, а эти —
# исходники headless-сборки (спек §59.3, CLAUDE.md «Headless simulation probes»).
!HexLive.Simulation.Standalone.csproj
!/Server/**/*.csproj
!/Tests/**/*.csproj
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

.vs/
.vscode/
.idea/

# Unity generated files
*.apk
*.aab
*.unitypackage
*.app

# Crash reporting
sysinfo.txt

# Editor screenshot dumps (MCP verification shots) — never commit
Assets/Screenshots/
Assets/Screenshots.meta
*.blob

# Scratch import folder for source FBX drops (extracted assets are committed,
# the multi-hundred-MB sources are not). The folder itself is caught by the
# global [Tt]emp/ rule; the stray .meta needs its own line.
Assets/Temp.meta

# Which drop the next extraction is scoped to — a per-run scratch value written
# by tools/wardrobe, not project content (NewWearExtractor.ActiveDropFile).
Assets/Editor/WearDrops/_active.txt
Assets/Editor/WearDrops/_active.txt.meta

# Huge third-party animal pack — kept locally, never committed (wolf assets copied to Assets/HexLive/Art/Wolf)
/[Aa]ssets/ANIMALS FULL PACK/
/[Aa]ssets/ANIMALS FULL PACK.meta

# §67.12: FMOD-интеграция — 297 МБ сторонних бинарников, качается с fmod.com
# («FMOD for Unity», версия обязана совпадать с FMOD Studio: сейчас 2.03.14).
/Assets/Plugins/FMOD/
# §67.10: FMOD Studio при импорте КОПИРУЕТ аудио к себе — это байт-в-байт те же
# реплики, что уже лежат в StreamingAssets (LFS). Восстанавливается прогоном
# FMODStudio/Scripts/sync_voices.js, дублировать 205 МБ в LFS незачем.
/FMODStudio/HexLive/Assets/
# Лог редактора FMOD.
/fmod_editor.log
# Локальные заглушки на машине без импортированного FMOD: дают проекту
# собраться, но НИКОГДА не должны уехать туда, где FMOD настоящий — иначе
# типы задвоятся (CS0101). Удаляются сразу после импорта интеграции.
*.local.cs
*.local.cs.meta

# Blender's rolling backup is local recovery state; the authored .blend is tracked via LFS.
*.blend1

# Python bytecode cache from Tools/*.py (build_release, wardrobe, icon render…).
__pycache__/
*.pyc
# Mono/Unity crash dumps land at the repo root; they are local diagnostics.
/mono_crash.*.json
# Stable advisory lock for the BUGS.json Unity MCP lease; the owner/state
# itself is tracked inside BUGS.json, this empty coordination file is not.
/BUGS.json.unity-mcp.lock
# .meta files Unity generates next to ignored Blender backups.
*.blend1.meta
_ArtSource/Voice/lipsync_analysis.json

# com.unity.test-framework.performance пишет эти заглушки в Assets/Resources
# при каждом прогоне перф-тестов и оставляет их пустыми. Локальный мусор.
/[Aa]ssets/Resources/PerformanceTestRunInfo.json
/[Aa]ssets/Resources/PerformanceTestRunInfo.json.meta
/[Aa]ssets/Resources/PerformanceTestRunSettings.json
/[Aa]ssets/Resources/PerformanceTestRunSettings.json.meta

# Артефакты прогонов dotnet test (.trx) — локальные результаты, не исходники.
/Tests/**/TestResults/
