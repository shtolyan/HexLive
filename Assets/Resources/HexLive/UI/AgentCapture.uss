.agent-capture {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(2, 9, 14, 0.6);
}
.agent-capture-visible { display: flex; }
.agent-capture-card {
    width: 300px;
    max-width: 90%;
    padding: 28px;
    align-items: center;
    background-color: rgb(7, 24, 31);
    border-width: 1px;
    border-color: rgb(45, 133, 144);
    border-radius: 24px;
}
.agent-capture-icon { width: 62px; height: 62px; margin-bottom: 16px; }
.agent-capture-title { color: rgb(222, 244, 247); font-size: 20px; }
.agent-capture-meter { flex-direction: row; height: 38px; margin-top: 20px; margin-bottom: 24px; }
.agent-capture-bar { width: 7px; margin-left: 3px; background-color: rgb(23, 61, 71); border-radius: 4px; }
.agent-capture-lit { background-color: rgb(69, 222, 209); }
.agent-capture-done {
    align-self: stretch;
    height: 46px;
    background-color: rgb(45, 178, 165);
    color: rgb(3, 23, 29);
    border-width: 0;
    border-radius: 14px;
    font-size: 18px;
}
.agent-capture-done:hover { background-color: rgb(73, 211, 197); }
.agent-capture-cancel {
    margin-top: 12px;
    padding: 8px 16px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(166, 193, 200);
    border-width: 0;
    font-size: 14px;
}
.agent-capture-cancel:hover { color: rgb(237, 248, 250); }
