.hut-constructor-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: flex-end;
    padding-left: 18px;
    padding-right: 18px;
    padding-bottom: 16px;
}

.constructor-panel {
    width: 1180px;
    height: 246px;
    max-width: 96%;
    background-color: rgba(25, 34, 29, 0.97);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(213, 199, 151, 0.46);
    border-right-color: rgba(213, 199, 151, 0.46);
    border-top-color: rgba(213, 199, 151, 0.46);
    border-bottom-color: rgba(213, 199, 151, 0.46);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
}

.tray-header {
    height: 48px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgb(20, 28, 24);
    border-bottom-width: 1px;
    border-bottom-color: rgba(143, 166, 143, 0.34);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
}

.mode-tabs, .header-actions, .selection-actions, .tray-body, .catalog-list {
    flex-direction: row;
}

.mode-tabs {
    height: 100%;
    align-items: flex-end;
}

.mode-tab {
    width: 150px;
    height: 40px;
    margin-right: 5px;
    color: rgb(221, 224, 213);
    background-color: rgba(48, 62, 53, 0.62);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: transparent;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    -unity-font-style: bold;
    font-size: 13px;
}

.mode-tab:hover, .category-button:hover, .catalog-card:hover,
.icon-button:hover, .header-button:hover, .selection-button:hover {
    background-color: rgb(57, 73, 63);
}

.mode-tab.active {
    color: rgb(25, 33, 28);
    background-color: rgb(225, 207, 150);
    border-bottom-color: rgb(240, 180, 92);
}

.header-copy {
    flex-grow: 1;
    min-width: 0;
    padding-left: 12px;
    padding-right: 8px;
}

.panel-title {
    color: rgb(239, 186, 102);
    font-size: 13px;
    -unity-font-style: bold;
}

.panel-status, .shortcut-label {
    color: rgba(220, 227, 220, 0.70);
    font-size: 10px;
    white-space: normal;
}

.header-actions {
    align-items: center;
}

.icon-button, .header-button {
    height: 32px;
    margin-left: 5px;
    color: rgb(226, 229, 218);
    background-color: rgb(42, 55, 47);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(255, 255, 255, 0.10);
    border-top-color: rgba(255, 255, 255, 0.10);
    border-bottom-color: rgba(255, 255, 255, 0.10);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.icon-button { width: 35px; font-size: 18px; }
.header-button { min-width: 78px; font-size: 10px; }
.header-button.accent { color: rgb(28, 34, 29); background-color: rgb(224, 187, 98); }

.tray-body {
    flex-grow: 1;
    min-height: 0;
}

.category-scroll {
    width: 166px;
    padding-top: 9px;
    padding-left: 9px;
    padding-right: 9px;
    padding-bottom: 9px;
    background-color: rgba(15, 23, 19, 0.55);
    border-right-width: 1px;
    border-right-color: rgba(143, 166, 143, 0.26);
}

.category-list { flex-grow: 1; }

.category-button {
    height: 30px;
    margin-bottom: 5px;
    padding-left: 10px;
    color: rgb(216, 222, 212);
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    -unity-text-align: middle-left;
    font-size: 11px;
}

.category-button.active {
    color: rgb(26, 35, 29);
    background-color: rgb(151, 190, 122);
    -unity-font-style: bold;
}

.catalog-area {
    flex-grow: 1;
    min-width: 0;
    padding-top: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 7px;
}

.category-title {
    height: 21px;
    color: rgb(232, 225, 203);
    font-size: 12px;
    -unity-font-style: bold;
}

.catalog-scroll {
    flex-grow: 1;
    min-height: 0;
}

.catalog-list {
    align-items: stretch;
    padding-bottom: 3px;
}

.catalog-card {
    width: 122px;
    height: 129px;
    margin-right: 8px;
    padding-top: 6px;
    padding-left: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    background-color: rgb(43, 56, 48);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.13);
    border-right-color: rgba(255, 255, 255, 0.13);
    border-top-color: rgba(255, 255, 255, 0.13);
    border-bottom-color: rgba(255, 255, 255, 0.13);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.catalog-card.active {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(238, 188, 92);
    border-right-color: rgb(238, 188, 92);
    border-top-color: rgb(238, 188, 92);
    border-bottom-color: rgb(238, 188, 92);
    background-color: rgb(53, 68, 58);
}

.catalog-thumb {
    height: 67px;
    margin-bottom: 5px;
    color: rgb(41, 48, 40);
    background-color: rgb(208, 194, 151);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    font-size: 29px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.catalog-name {
    color: rgb(235, 231, 216);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
}

.catalog-description {
    color: rgba(213, 220, 211, 0.66);
    font-size: 9px;
    white-space: normal;
}

.selection-card {
    width: 236px;
    padding-top: 12px;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 10px;
    background-color: rgba(35, 47, 40, 0.96);
    border-left-width: 1px;
    border-left-color: rgba(143, 166, 143, 0.30);
    border-bottom-right-radius: 14px;
}

.selection-title {
    color: rgb(239, 186, 102);
    font-size: 10px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.selection-label {
    color: rgb(232, 229, 216);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 5px;
    white-space: normal;
}

.selection-description {
    flex-grow: 1;
    color: rgba(211, 220, 211, 0.72);
    font-size: 10px;
    white-space: normal;
}

.availability-label {
    align-self: flex-start;
    margin-top: 5px;
    margin-bottom: 7px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 3px;
    padding-bottom: 3px;
    color: rgb(220, 243, 220);
    background-color: rgb(46, 98, 66);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    font-size: 9px;
    -unity-font-style: bold;
}

.availability-label.waiting {
    color: rgb(255, 229, 181);
    background-color: rgb(116, 76, 35);
}

.selection-button {
    flex-grow: 1;
    height: 29px;
    margin-right: 5px;
    color: rgb(224, 229, 220);
    background-color: rgb(46, 60, 51);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    font-size: 10px;
}

.selection-button.danger { color: rgb(245, 130, 127); }
.shortcut-label { height: 17px; }
