.lobby-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.lobby { flex-grow: 1; background-color: rgb(17, 25, 29); color: rgb(233, 233, 220); padding: 24px; }
.lobby-title { flex-grow: 1; font-size: 28px; -unity-font-style: bold; }
.lobby-toolbar { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 12px; }
.lobby-toolbar > * { margin-right: 12px; }
.lobby-content { flex-grow: 1; min-height: 0; }
.lobby-columns { flex-direction: row; flex-grow: 1; min-height: 0; }
.lobby-map { flex-grow: 3; flex-basis: 0; overflow: hidden; background-color: rgb(18, 49, 65); margin-right: 16px; }
.lobby-details { flex-grow: 2; flex-basis: 0; min-width: 340px; }
.lobby-card { background-color: rgb(31, 43, 48); padding: 12px; margin-top: 8px; margin-bottom: 8px; border-radius: 6px; }
.lobby Button { background-color: rgb(58, 76, 80); color: rgb(250, 243, 221); padding: 8px 16px; margin-top: 5px; margin-bottom: 5px; min-height: 34px; border-radius: 5px; }
.lobby Button:hover { background-color: rgb(81, 108, 109); }
.lobby Button:disabled { opacity: 0.45; }
.lobby .unity-base-field { margin-top: 5px; margin-bottom: 5px; }
.lobby .unity-base-field__label { min-width: 155px; color: rgb(220, 224, 220); }
.lobby .unity-base-field__input { background-color: rgb(38, 50, 54); color: rgb(247, 246, 231); }
.lobby-status { color: rgb(245, 188, 107); white-space: normal; max-height: 150px; }
.lobby-preview { flex-grow: 2; flex-basis: 0; margin-right: 20px; }
.lobby-doll { flex-grow: 1; min-height: 200px; }
.lobby-clothing { height: 330px; }

.lobby-clothing-row { flex-direction: row; align-items: center; min-height: 46px; }
.lobby-item-icon { width: 40px; height: 40px; margin-right: 8px; }

.lobby-editor { flex-grow: 3; flex-basis: 0; min-width: 420px; min-height: 0; }
.lobby-modes { flex-direction: row; }
.lobby-modes > Button { flex-grow: 1; font-size: 22px; min-height: 52px; }
.lobby-appearance { flex-grow: 1; min-height: 0; }
.lobby-tabs { flex-direction: row; flex-wrap: wrap; }
.lobby-tabs > Button { flex-grow: 1; margin-right: 4px; padding: 6px 9px; }
.lobby-catalog { flex-grow: 1; min-height: 120px; }
.lobby-tile-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.lobby .lobby-tile { width: 108px; height: 142px; padding: 4px; margin: 4px; border-width: 2px; border-color: rgb(57, 72, 77); justify-content: flex-start; }
.lobby-tile-image { height: 98px; flex-shrink: 0; }
.lobby-tile > Label { white-space: normal; font-size: 11px; -unity-text-align: middle-center; overflow: hidden; }
.lobby .lobby-selected { border-width: 2px; border-color: rgb(160, 206, 169); background-color: rgb(55, 94, 82); }
.lobby-variants { height: 225px; flex-shrink: 0; background-color: rgb(24, 36, 40); padding: 8px; margin-top: 8px; }
.lobby-variant-scroll { flex-grow: 1; min-height: 0; }
.lobby-parameters { flex-grow: 1; min-height: 0; }
.lobby-hidden { display: none; }
.lobby-camera-help { white-space: normal; font-size: 11px; color: rgb(173, 190, 193); }
.lobby .lobby-focused { border-color: rgb(236, 202, 129); }
