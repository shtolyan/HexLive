<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="ClientUpdatePanel.uss" />
  <ui:VisualElement name="updateRoot" class="update-root">
    <ui:VisualElement class="update-panel">
      <ui:Label name="status" />
      <ui:Label name="details" />
      <ui:ProgressBar name="progress" low-value="0" high-value="100" />
      <ui:Button name="check" class="update-secondary" />
      <ui:Button name="download" />
      <ui:Button name="install" />
      <ui:Button name="cancel" class="update-secondary" />
      <ui:Button name="later" class="update-secondary" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
