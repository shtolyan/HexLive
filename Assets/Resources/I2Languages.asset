        \u0417\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0440\u0443\u043A\u0438,
        \u0438 \u0442\u043E\u043B\u044C\u043A\u043E."
      Flags: 0101
      Languages_Touch: []
    - Term: item.clothing_shirt_amy_08.name
      TermType: 0
      Description: 
      Languages:
      - Street Shirt (08)
      - "\u0423\u043B\u0438\u0447\u043D\u0430\u044F \u0440\u0443\u0431\u0430\u0448\u043A\u0430
