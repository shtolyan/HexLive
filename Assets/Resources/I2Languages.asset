      Flags: 0101
      Languages_Touch: []
    - Term: journal.WearPermissionRefused.did.v0
      TermType: 0
      Description: 
      Languages:
      - '{0} asked for my things. I said no. They''re mine.'
      - "{0} \u043F\u0440\u043E\u0441\u0438\u043B\u0430 \u043C\u043E\u0438 \u0432\u0435\u0449\u0438.
        \u042F \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0430. \u041E\u043D\u0438
        \u043C\u043E\u0438."
      Flags: 0101
      Languages_Touch: []
    - Term: journal.WearPermissionRefused.did.bitter.v0
      TermType: 0
      Description: 
      Languages:
