    - Term: 'item.underwear_bra_lace_dream_lace_3_bra_black.name'
      TermType: 0
      Description: 
      Languages:
      - 'Lace Bra (Dream Lace 3 Bra Black)'
      - 'Кружевной лиф (Dream Lace 3 Bra Black)'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.underwear_bra_lace_dream_lace_3_bra_black.desc'
      TermType: 0
      Description: 
      Languages:
      - 'Worn against the skin. She notices when it is gone.'
      - 'На голое тело. Без него замечает сразу.'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.underwear_briefs_lace_dream_lace_3_panty_black.name'
      TermType: 0
