      - 'Подсумки на поясе'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.gear_beltpouch_ranger.desc'
      TermType: 0
      Description: 
      Languages:
      - 'Two pouches and a buckle. No warmth — they are there to carry things.'
      - 'Два подсумка и пряжка. Не греют — они чтобы носить.'
      Flags: 0101
      Languages_Touch: []
