      Languages_Touch: []
    - Term: 'item.clothing_headband_primal_2.desc'
      TermType: 0
      Description: 
      Languages:
      - 'A band across the brow. Keeps sweat and hair out of her eyes.'
      - 'Полоса по лбу. Убирает из глаз пот и волосы.'
      Flags: 0101
      Languages_Touch: []
