    - Term: 'item.clothing_wrapboots_primal_1.name'
      TermType: 0
      Description: 
      Languages:
      - 'Wrapped Boots (1)'
      - 'Обмотанные сапоги (1)'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.clothing_wrapboots_primal_1.desc'
      TermType: 0
      Description: 
      Languages:
      - 'Hide bound around foot and shin with cord. Quiet on anything.'
      - 'Кожа, примотанная шнуром к ступне и голени. Тихие по любому грунту.'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.clothing_wrapboots_primal_2.name'
      TermType: 0
