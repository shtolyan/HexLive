    - Term: 'item.clothing_top_anarchy_red.name'
      TermType: 0
      Description: 
      Languages:
      - 'Anarchy Top (Red)'
      - 'Топ «Анархия» (Red)'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.clothing_top_anarchy_red.desc'
      TermType: 0
      Description: 
      Languages:
