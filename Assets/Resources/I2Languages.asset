      Flags: 0101
      Languages_Touch: []
    - Term: 'item.clothing_boots_ranger.desc'
      TermType: 0
      Description: 
      Languages:
      - 'Reinforced to mid-calf. The best thing between a wolf and her ankle.'
      - 'Усилены до середины икры. Лучшее между волком и её лодыжкой.'
