      Languages:
      - Unknown
      - "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E"
      Flags: 0101
      Languages_Touch: []
    - Term: item.unknown.desc
      TermType: 0
      Description: 
      Languages:
      - 'This item is in the inventory, but its definition is missing: {0}.'
      - "\u042D\u0442\u043E\u0442 \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0435\u0441\u0442\u044C
        \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435, \u043D\u043E
