      - "\u0437\u0432\u0430\u043B\u0430 \u043A\u043E\u0433\u043E-\u0442\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C"
      Flags: 0101
      Languages_Touch: []
    - Term: journal.chore.InteractionBlocked
      TermType: 0
      Description: 
