      Flags: 0101
      Languages_Touch: []
    - Term: journal.FriendGuard.did.v0
      TermType: 0
      Description: 
      Languages:
      - I stood over {0} until it backed off.
      - "\u042F \u0441\u0442\u043E\u044F\u043B\u0430 \u043D\u0430\u0434 {0}, \u043F\u043E\u043A\u0430
