      Languages_Touch: []
    - Term: 'item.underwear_kneesocks_nerd_nc_sock_left_argyle.name'
      TermType: 0
      Description: 
      Languages:
      - 'Knee Socks (NC Sock Left Argyle)'
      - 'Гольфы (NC Sock Left Argyle)'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.underwear_kneesocks_nerd_nc_sock_left_argyle.desc'
      TermType: 0
      Description: 
      Languages:
      - 'To the knee, ribbed. More warmth than they look like they hold.'
      - 'До колена, в рубчик. Греют больше, чем кажется.'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.underwear_kneesocks_nerd_nc_sock_left_polka_dots.name'
