      Flags: 0101
      Languages_Touch: []
    - Term: 'item.clothing_shirt_riot_greydark.desc'
      TermType: 0
      Description: 
      Languages:
      - 'Plain and buttoned. What she puts on without thinking.'
      - 'Простая, на пуговицах. Надевает не думая.'
      Flags: 0101
      Languages_Touch: []
