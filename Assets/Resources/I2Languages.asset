      TermType: 0
      Description: 
      Languages:
      - 'Work Blouse (Denim)'
      - 'Рабочая блузка (Denim)'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.clothing_blouse_riot_denim.desc'
      TermType: 0
      Description: 
      Languages:
      - 'Long sleeves, buttoned to the throat. Thin, but it covers the arms.'
      - 'Длинные рукава, застёгнута под горло. Тонкая, зато руки закрыты.'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.clothing_blouse_riot_green.name'
      TermType: 0
