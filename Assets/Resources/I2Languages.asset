      Flags: 0101
      Languages_Touch: []
    - Term: journal.AidRequested.did.v0
      TermType: 0
      Description: 
      Languages:
      - "I set off to help {0} \u2014 {1}."
      - "\u041F\u043E\u0448\u043B\u0430 \u043A {0} \u2014 {1}."
