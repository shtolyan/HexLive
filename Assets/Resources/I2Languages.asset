      Languages_Touch: []
    - Term: item.clothing_blouse_riot_denim.name
      TermType: 0
      Description: 
      Languages:
      - Work Blouse (Denim)
      - "\u0420\u0430\u0431\u043E\u0447\u0430\u044F \u0431\u043B\u0443\u0437\u043A\u0430
        (Denim)"
      Flags: 0101
      Languages_Touch: []
    - Term: item.clothing_blouse_riot_denim.desc
      TermType: 0
      Description: 
      Languages:
      - Long sleeves, buttoned to the throat. Thin, but it covers the arms.
      - "\u0414\u043B\u0438\u043D\u043D\u044B\u0435 \u0440\u0443\u043A\u0430\u0432\u0430,
        \u0437\u0430\u0441\u0442\u0451\u0433\u043D\u0443\u0442\u0430 \u043F\u043E\u0434
        \u0433\u043E\u0440\u043B\u043E. \u0422\u043E\u043D\u043A\u0430\u044F, \u0437\u0430\u0442\u043E
        \u0440\u0443\u043A\u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u044B."
      Flags: 0101
      Languages_Touch: []
    - Term: item.clothing_blouse_riot_green.name
      TermType: 0
      Description: 
      Languages:
      - Work Blouse (Green)
      - "\u0420\u0430\u0431\u043E\u0447\u0430\u044F \u0431\u043B\u0443\u0437\u043A\u0430
        (Green)"
      Flags: 0101
      Languages_Touch: []
    - Term: item.clothing_blouse_riot_green.desc
      TermType: 0
      Description: 
      Languages:
      - Long sleeves, buttoned to the throat. Thin, but it covers the arms.
      - "\u0414\u043B\u0438\u043D\u043D\u044B\u0435 \u0440\u0443\u043A\u0430\u0432\u0430,
        \u0437\u0430\u0441\u0442\u0451\u0433\u043D\u0443\u0442\u0430 \u043F\u043E\u0434
