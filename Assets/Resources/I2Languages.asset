      Flags: 0101
      Languages_Touch: []
    - Term: journal.AidWaitTimeout.got.bitter.v0
      TermType: 0
      Description: 
      Languages:
      - I waited for {0} for so long. Nobody came at all.
      - "\u042F \u0442\u0430\u043A \u0434\u043E\u043B\u0433\u043E \u0436\u0434\u0430\u043B\u0430
