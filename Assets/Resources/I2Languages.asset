      TermType: 0
      Description: 
      Languages:
      - Filthy
      - "\u0413\u0440\u044F\u0437\u043D\u0430\u044F"
      Flags: 0101
      Languages_Touch: []
    - Term: effect.filthy.desc
      TermType: 0
      Description: 
      Languages:
