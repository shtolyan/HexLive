      Languages_Touch: []
    - Term: journal.WearPermissionGranted.did.v0
      TermType: 0
      Description: 
      Languages:
      - I lent {0} my things. She needed them more.
      - "\u041E\u0442\u0434\u0430\u043B\u0430 {0} \u0441\u0432\u043E\u0438 \u0432\u0435\u0449\u0438
