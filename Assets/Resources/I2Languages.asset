      Languages_Touch: []
    - Term: journal.AidStarted.did.v0
      TermType: 0
      Description: 
      Languages:
      - "I got to {0} and started on it \u2014 {1}."
      - "\u0414\u043E\u0448\u043B\u0430 \u0434\u043E {0} \u0438 \u0432\u0437\u044F\u043B\u0430\u0441\u044C
