      Flags: 0101
      Languages_Touch: []
    - Term: 'item.clothing_boots_classic.desc'
      TermType: 0
      Description: 
      Languages:
      - 'High leather boots. Warm, and they turn a bite that would open a bare shin.'
      - 'Высокие кожаные сапоги. Тёплые, и держат укус, который порвал бы голую голень.'
      Flags: 0101
      Languages_Touch: []
