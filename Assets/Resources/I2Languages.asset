    - Term: item.clothing_headband_primal_2.name
      TermType: 0
      Description: 
      Languages:
      - Hide Headband (2)
      - "\u041A\u043E\u0436\u0430\u043D\u0430\u044F \u043F\u043E\u0432\u044F\u0437\u043A\u0430
        (2)"
      Flags: 0101
      Languages_Touch: []
    - Term: item.clothing_headband_primal_2.desc
      TermType: 0
      Description: 
      Languages:
      - A band across the brow. Keeps sweat and hair out of her eyes.
      - "\u041F\u043E\u043B\u043E\u0441\u0430 \u043F\u043E \u043B\u0431\u0443. \u0423\u0431\u0438\u0440\u0430\u0435\u0442
        \u0438\u0437 \u0433\u043B\u0430\u0437 \u043F\u043E\u0442 \u0438 \u0432\u043E\u043B\u043E\u0441\u044B."
      Flags: 0101
      Languages_Touch: []
