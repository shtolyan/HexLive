    - Term: 'item.gear_backpack_riot_denim.name'
      TermType: 0
      Description: 
      Languages:
      - 'Canvas Backpack (Denim)'
      - 'Холщовый рюкзак (Denim)'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.gear_backpack_riot_denim.desc'
      TermType: 0
      Description: 
      Languages:
      - 'Straps, buckles and room. Carries more than her hands ever could.'
      - 'Лямки, пряжки и место. Несёт больше, чем когда-либо унесут руки.'
      Flags: 0101
      Languages_Touch: []
