    - Term: 'item.underwear_socks_fit_blue.name'
      TermType: 0
      Description: 
      Languages:
      - 'Ankle Socks (Blue)'
      - 'Носки (Blue)'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.underwear_socks_fit_blue.desc'
      TermType: 0
      Description: 
      Languages:
      - 'Plain and short. Worn until they are not.'
      - 'Простые и короткие. Носятся, пока носятся.'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.underwear_socks_fit_blue2.name'
      TermType: 0
      Description: 
      Languages:
      - 'Ankle Socks (Blue2)'
      - 'Носки (Blue2)'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.underwear_socks_fit_blue2.desc'
      TermType: 0
      Description: 
      Languages:
