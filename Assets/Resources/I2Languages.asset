      Languages_Touch: []
    - Term: item.clothing_necklace_beads.desc
      TermType: 0
      Description: 
      Languages:
      - Beads on a metal chain. Worth nothing and kept anyway.
      - "\u0411\u0443\u0441\u0438\u043D\u044B \u043D\u0430 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0439
