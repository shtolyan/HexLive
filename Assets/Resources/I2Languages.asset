    - Term: 'item.underwear_bra_lace_dream_lace_3_bra.name'
      TermType: 0
      Description: 
      Languages:
      - 'Lace Bra (Dream Lace 3 Bra)'
      - 'Кружевной лиф (Dream Lace 3 Bra)'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.underwear_bra_lace_dream_lace_3_bra.desc'
      TermType: 0
      Description: 
      Languages:
      - 'Worn against the skin. She notices when it is gone.'
      - 'На голое тело. Без него замечает сразу.'
