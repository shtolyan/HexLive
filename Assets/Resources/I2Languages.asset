    - Term: 'item.clothing_shorts_fit_1_blackblue.name'
      TermType: 0
      Description: 
      Languages:
      - 'Running Shorts (1 BlackBlue)'
      - 'Беговые шорты (1 BlackBlue)'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.clothing_shorts_fit_1_blackblue.desc'
      TermType: 0
      Description: 
      Languages:
      - 'Light and short. Nothing between her legs and the weather.'
      - 'Лёгкие и короткие. Между ногами и погодой ничего.'
      Flags: 0101
      Languages_Touch: []
