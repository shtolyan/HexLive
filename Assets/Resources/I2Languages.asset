      Flags: 0101
      Languages_Touch: []
    - Term: 'item.clothing_skirt_primal_1.desc'
      TermType: 0
      Description: 
      Languages:
      - 'Cut short and left ragged. Moves without asking.'
      - 'Обрезана коротко и оставлена рваной. Двигается не спрашивая.'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.clothing_skirt_primal_2.name'
      TermType: 0
      Description: 
      Languages:
      - 'Hide Skirt (2)'
      - 'Кожаная юбка (2)'
      Flags: 0101
      Languages_Touch: []
