      Languages_Touch: []
    - Term: item.clothing_boots_classic.desc
      TermType: 0
      Description: 
      Languages:
      - Laced high, soled thin. Made for a canvas floor.
      - "\u0412\u044B\u0441\u043E\u043A\u0430\u044F \u0448\u043D\u0443\u0440\u043E\u0432\u043A\u0430,
