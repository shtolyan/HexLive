      - 'Обрезанные шорты (Brown)'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.clothing_shorts_riot_brown.desc'
      TermType: 0
      Description: 
      Languages:
      - 'Denim, cut at the thigh. Nothing between her knees and the weather.'
      - 'Джинса, обрезана по бедру. Между коленями и погодой ничего.'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.clothing_shorts_riot_denimgrey.name'
