      TermType: 0
      Description: 
      Languages:
      - 'Hide Briefs (Panty1)'
      - 'Кожаная набедренная повязка (Panty1)'
      Flags: 0101
      Languages_Touch: []
    - Term: 'item.underwear_briefs_primal_panty1.desc'
      TermType: 0
      Description: 
      Languages:
      - 'Soft hide, tied at the hip. The oldest thing anyone wears.'
      - 'Мягкая кожа, завязана на бедре. Древнейшее, что вообще носят.'
      Flags: 0101
      Languages_Touch: []
