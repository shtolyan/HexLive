<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BaseOutputPath>../../Build/dotnet/bin/HexLive.AgentCore/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- One implementation shared by CLI and desktop; no Unity dependency. -->
    <Compile Include="../HexLive.AgentHost/*.cs" Exclude="../HexLive.AgentHost/Program.cs" Link="Runtime/%(Filename)%(Extension)" />
    <Content Include="../HexLive.AgentHost/Prompts/*" Link="AgentPrompts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
