    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HexLive.AgentHost</RootNamespace>
    <AssemblyName>HexLive.AgentHost</AssemblyName>
    <OutputType>Exe</OutputType>
