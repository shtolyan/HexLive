<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Headless HexLive: the colony keeps living with no Unity anywhere.

    Deliberately ZERO NuGet packages. WebSockets come from the ASP.NET Core
    shared framework (already on any machine with the .NET runtime), and the
    simulation comes from the same 130 source files Unity compiles. Keeping the
    dependency list empty is what makes "the server and the game run identical
    code" a fact rather than a hope.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>HexLive.Server</RootNamespace>
    <AssemblyName>HexLive.Server</AssemblyName>
    <BaseOutputPath>../../Build/dotnet/bin/HexLive.Server/</BaseOutputPath>
    <!-- No launchSettings/appsettings scaffolding: this is a console daemon. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../HexLive.Simulation.Standalone.csproj" />
  </ItemGroup>

  <!--
    §144.9: the spec travels WITH the server.

    An MCP agent reaches this process over HTTP and may be on another machine
    entirely: it has no repository, no checkout, no filesystem here. Without
    these files the only thing it can ever learn about the world is twelve tool
    descriptions — and the rules that actually decide whether an order succeeds
    (§121.6 "she consumes only her own", §64.9 "the palm IS the water supply")
    live in the spec, not in a parameter list.

    Content, not EmbeddedResource: 2.1 MB of Markdown that changes on nearly
    every commit has no business inflating the assembly, and a plain directory
    stays readable by a human debugging the server on the box.
  -->
  <ItemGroup>
    <Content Include="../../Spec/*.md"
             Link="Spec/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../spec.md"
             Link="Spec/spec.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
