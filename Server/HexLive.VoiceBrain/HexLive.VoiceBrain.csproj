<Project Sdk="Microsoft.NET.Sdk">
  <!-- §171.7: voice brain core — ElevenLabs Agents "custom LLM" turn, tickets, usage. Hosted by HexLive.Server (§171.8) or the standalone prototype host. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BaseOutputPath>../../Build/dotnet/bin/HexLive.VoiceBrain/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- §171.11: the browser half, served by whichever process hosts the brain. -->
    <EmbeddedResource Include="Client/hexlive-voice.js" LogicalName="HexLive.VoiceBrain.hexlive-voice.js" />
    <EmbeddedResource Include="Client/usage-tariffs.json" LogicalName="HexLive.VoiceBrain.usage-tariffs.json" />
    <ProjectReference Include="../HexLive.AgentCore/HexLive.AgentCore.csproj" />
  </ItemGroup>
</Project>
