    <UnitTestResult executionId="3a181b40-11a8-4814-9bb9-63e575efad96" testId="6cf68993-5933-666a-62d6-8d2adb3089ef" testName="CameraHasFrameFollowDetachAndUiAwareFit" computerName="Anatolys-MacBook-Air" duration="00:00:00.0096710" startTime="2026-08-16T00:28:07.7448080+07:00" endTime="2026-08-16T00:28:07.7544790+07:00" testType="13cdc9d9-ddb5-4fa4-a97d-d965ccfc6d4b" outcome="Failed" testListId="8c84fa94-04c1-424b-9868-57a2d4851a1d" relativeResultsDirectory="3a181b40-11a8-4814-9bb9-63e575efad96">
